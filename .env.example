# CODETRACE Configuration Template
APP_NAME=CODETRACE
ENV=development

# LLM Configuration (Optional API keys)
OPENAI_API_KEY=your_openai_api_key_here

# Vector DB (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Graph DB (Neo4j)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Relational DB (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=codetrace
POSTGRES_PASSWORD=codetrace_pass
POSTGRES_DB=codetrace_db

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
